SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=eventflow_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=127.0.0.1
DB_PORT=5432
# En production (Render/Neon), DATABASE_URL remplace la configuration ci-dessus.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ------------------------------------------------------------------
# Admin Django / documentation
# ------------------------------------------------------------------
# Chemin de l'admin (doit finir par "/").
ADMIN_URL=admin/
# Documentation OpenAPI : laisser False en production.
API_DOCS_ENABLED=True

# ------------------------------------------------------------------
# Compte administrateur (commande create_admin)
# ------------------------------------------------------------------
# Obligatoires. Aucun mot de passe par défaut n'est utilisé.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Eventflow
ADMIN_PHONE=+221770000000
# Mettre True uniquement pour réinitialiser le mot de passe d'un compte existant.
ADMIN_RESET_PASSWORD=False

# ------------------------------------------------------------------
# QR codes (signature HMAC des billets)
# ------------------------------------------------------------------
# Clé dédiée, distincte de SECRET_KEY (recommandé).
QR_SIGNING_KEY=change-me-qr-signing-key

# ------------------------------------------------------------------
# Paiements
# ------------------------------------------------------------------
PAYMENT_DEFAULT_CURRENCY=XOF
# True uniquement en développement local (simulateur).
PAYMENT_DEVELOPMENT_ENABLED=True

# ------------------------------------------------------------------
# Attendance
# ------------------------------------------------------------------
ATTENDANCE_CHECK_IN_OPENS_BEFORE_MINUTES=120

# ------------------------------------------------------------------
# CORS (frontend Angular)
# ------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# ------------------------------------------------------------------
# Médias (images de couverture, certificats)
# ------------------------------------------------------------------
# En production avec un disque persistant Render, pointer vers son montage.
# MEDIA_ROOT=/var/data/media
#
# Stockage externe compatible S3 (recommandé : disque Render éphémère).
# Laisser AWS_STORAGE_BUCKET_NAME vide pour utiliser le disque local.
# Exemples d'endpoints :
#   Supabase : https://<projet>.supabase.co/storage/v1/s3   (région = celle du projet)
#   R2       : https://<account-id>.r2.cloudflarestorage.com (région = auto)
#   B2       : https://s3.<region>.backblazeb2.com
# AWS_S3_PUBLIC_URL : URL publique du bucket (R2 : https://pub-xxxx.r2.dev,
#   Supabase : https://<projet>.supabase.co/storage/v1/object/public/<bucket>).
#   Si vide, des URL signées temporaires sont générées (bucket privé).
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=auto
AWS_S3_PUBLIC_URL=
AWS_S3_QUERYSTRING_EXPIRE=3600

# ------------------------------------------------------------------
# E-mail
# ------------------------------------------------------------------
# Développement : console. Production : SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre-email@gmail.com
EMAIL_HOST_PASSWORD=votre-mot-de-passe-application
DEFAULT_FROM_EMAIL=EVENTFLOW <noreply@eventflow.sn>

# ------------------------------------------------------------------
# Supervision : limitation du débit par administrateur
# ------------------------------------------------------------------
SUPERVISION_READ_RATE=300/min
SUPERVISION_ACTION_RATE=30/min

# ------------------------------------------------------------------
# Certificats
# ------------------------------------------------------------------
FRONTEND_URL=http://localhost:4200
CERTIFICATE_VERIFY_URL_BASE=http://localhost:4200/verify
