SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=eventflow_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=127.0.0.1
DB_PORT=5432

# Payment
PAYMENT_DEFAULT_CURRENCY=XOF
PAYMENT_DEVELOPMENT_ENABLED=True

# ATTENDANCE_CHECK_IN_OPENS_BEFORE_MINUTES=45

CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=EVENTFLOW <noreply@eventflow.sn>

# Attendance : ouverture du check-in X minutes avant le début de l'événement
ATTENDANCE_CHECK_IN_OPENS_BEFORE_MINUTES=120

# Supervision : limitation du débit par administrateur
SUPERVISION_READ_RATE=300/min
SUPERVISION_ACTION_RATE=30/min

# Certificates
FRONTEND_URL=http://localhost:4200
CERTIFICATE_VERIFY_URL_BASE=http://localhost:4200/verify

# e-mail
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre-email@gmail.com
EMAIL_HOST_PASSWORD=votre-mot-de-passe-application
DEFAULT_FROM_EMAIL=votre-email@gmail.com
